{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
    "@components/*": ["./src/components/*"],
    "@context/*": ["./src/context/*"],
    "@hooks/*": ["./src/hooks/*"],
    "@pages/*": ["./src/pages/*"],
    "@utils/*": ["./src/utils/*"],
    "@assets/*": ["./src/assets/*"],
  }
  },
  "include": ["src"],
}